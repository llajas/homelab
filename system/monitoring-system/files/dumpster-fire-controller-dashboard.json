{
  "uid": "dumpster-fire-controller",
  "title": "Dumpster Fire | Austin incident report",
  "description": "A very real count of new Austin dumpster and trash fire dispatches observed by the controller. Counts are based on deduplicated incident IDs, not lamp toggles or feed size.",
  "tags": ["dumpster-fire", "austin", "incidents"],
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "panels": [
    {
      "id": 10,
      "title": "The actual dumpster fire report",
      "type": "text",
      "options": {"mode": "markdown", "content": "# The actual dumpster fire report\nAustin dispatches, counted once per new dumpster or trash fire. The tiny plastic dumpster is only the messenger.\n\n**Counting starts when the controller begins observing.** These are rolling windows of observed incidents, not the city's all-time total."},
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0}
    },
    {
      "id": 7,
      "title": "Fires spotted in the last 24 hours",
      "description": "New, deduplicated DUMP and TRASH incident IDs observed by the controller. An empty panel means metrics are unavailable, not zero fires.",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(increase(dumpster_fire_new_incidents_total{namespace=\"dumpster-fire\"}[24h]))", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "orange"}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value"},
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 4}
    },
    {
      "id": 11,
      "title": "Last 6 hours",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(increase(dumpster_fire_new_incidents_total{namespace=\"dumpster-fire\"}[6h]))", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "orange"}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value"},
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 4}
    },
    {
      "id": 12,
      "title": "Last hour",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(increase(dumpster_fire_new_incidents_total{namespace=\"dumpster-fire\"}[1h]))", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "orange"}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value"},
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 4}
    },
    {
      "id": 13,
      "title": "The slow burn | new incidents per hour",
      "description": "Rolling one-hour count of newly observed incidents. Each point is a rolling window, not a separate bucket; do not sum the points.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(increase(dumpster_fire_new_incidents_total{namespace=\"dumpster-fire\"}[1h]))", "legendFormat": "New incidents / hour", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "min": 0, "color": {"mode": "fixed", "fixedColor": "orange"}, "custom": {"drawStyle": "line", "fillOpacity": 20, "lineWidth": 2}}, "overrides": []},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 10}
    },
    {
      "id": 1,
      "title": "Latest poll succeeded",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "dumpster_fire_poll_success{namespace=\"dumpster-fire\"}", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "mappings": [{"type": "value", "options": {"0": {"text": "FAILED", "color": "red"}, "1": {"text": "OK", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 19}
    },
    {
      "id": 2,
      "title": "Controller enabled",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "dumpster_fire_controller_enabled{namespace=\"dumpster-fire\"}", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "mappings": [{"type": "value", "options": {"0": {"text": "DISABLED", "color": "gray"}, "1": {"text": "ENABLED", "color": "green"}}}], "unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 19}
    },
    {
      "id": 3,
      "title": "Activity window active",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "dumpster_fire_activity_active{namespace=\"dumpster-fire\"}", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "mappings": [{"type": "value", "options": {"0": {"text": "INACTIVE"}, "1": {"text": "ACTIVE", "color": "orange"}}}], "unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 19}
    },
    {
      "id": 4,
      "title": "Flame state known",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "dumpster_fire_flame_state_known{namespace=\"dumpster-fire\"}", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "mappings": [{"type": "value", "options": {"0": {"text": "UNKNOWN", "color": "red"}, "1": {"text": "KNOWN", "color": "green"}}}], "unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 19}
    },
    {
      "id": 5,
      "title": "Feed polls by outcome",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (result) (rate(dumpster_fire_polls_total{namespace=\"dumpster-fire\"}[15m]))", "legendFormat": "{{result}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 23}
    },
    {
      "id": 6,
      "title": "Poll duration",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(dumpster_fire_poll_duration_seconds_bucket{namespace=\"dumpster-fire\"}[15m])))", "legendFormat": "p95", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 23}
    },
    {
      "id": 8,
      "title": "Trigger submissions (not incidents)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (desired_state) (increase(dumpster_fire_trigger_submissions_total{namespace=\"dumpster-fire\"}[24h]))", "legendFormat": "{{desired_state}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 5, "w": 12, "x": 0, "y": 31}
    },
    {
      "id": 9,
      "title": "Seconds until activity deadline",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "clamp_min(dumpster_fire_activity_deadline_timestamp_seconds{namespace=\"dumpster-fire\"} - time(), 0)", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 5, "w": 12, "x": 12, "y": 31}
    }
  ]
}
